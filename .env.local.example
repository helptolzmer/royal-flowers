# EmailJS – skopiuj ten plik jako .env.local i uzupełnij wartości
# Konto: https://www.emailjs.com/

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_OWNER=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_CLIENT=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxx

# Przelewy24 REST API
# Dokumentacja: https://developers.przelewy24.pl/
#
# Panel P24 → Moje dane → API
#   - Merchant ID: liczba (np. 395875)
#   - P24_CRC    : "Klucz (CRC)" – do podpisywania żądań
#   - P24_API_KEY: "Klucz do raportów" – TYLKO ten klucz do Basic Auth (NIE klucz CRC!)
#
# WAŻNE przed uruchomieniem:
#   1. W panelu P24 → API → dozwolone IP: wpisz "%" aby akceptować wszystkie IP
#   2. Aktywuj REST API w panelu (lub poproś support P24)
#   3. Sandbox: załóż konto na sandbox.przelewy24.pl/panel, ustaw P24_SANDBOX=true

P24_MERCHANT_ID=xxxxxxxx
P24_CRC=xxxxxxxxxxxxxxxx
P24_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# true = sandbox.przelewy24.pl (testy), false/brak = secure.przelewy24.pl (produkcja)
P24_SANDBOX=false

# Adres produkcyjny strony (bez końcowego /)
SITE_URL=https://twojadomena.pl
